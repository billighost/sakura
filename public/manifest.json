{
  "id": "/home",
  "name": "Sakura — your little music world",
  "short_name": "Sakura",
  "description": "Music, with room to breathe.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f5f5ee",
  "theme_color": "#446b57",
  "categories": [
    "music",
    "entertainment"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/icons/ink.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/ink-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/ink-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
