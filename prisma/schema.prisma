generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid())
  username         String             @unique
  email            String             @unique
  passwordHash     String
  avatarUrl        String?
  bio              String?
  createdAt        DateTime           @default(now())
  
  settings         UserSettings?
  playlists        Playlist[]
  playlistFolders  PlaylistFolder[]
  favorites        Favorite[]
  snoozedTracks    SnoozedTrack[]
  listeningHistory ListeningHistory[]
  mixes            UserMix[]
  tasteProfile     TasteProfile?
  artistAffinities ArtistAffinity[]
  genreAffinities  GenreAffinity[]
  tasteFeedback    TasteFeedback[]
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  theme                String   @default("dark")
  audioQuality         String   @default("high")
  downloadQuality      String   @default("high")
  crossfadeSeconds     Int      @default(0)
  autoDownloadLiked    Boolean  @default(false)
  gaplessPlayback      Boolean  @default(true)
  normalizeVolume      Boolean  @default(true)
  explicitContent      Boolean  @default(true)
  privateSession       Boolean  @default(false)
  pushNotifications    Boolean  @default(true)
  newReleaseAlerts     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Artist {
  id         String   @id @default(uuid())
  name       String   @unique
  imageUrl   String?
  bio        String?
  deezerId   String?
  genres     String[]
  createdAt  DateTime @default(now())

  albums        Album[]
  tracks        Track[]
  trackArtists  TrackArtist[]
  affinities    ArtistAffinity[]
}

model Album {
  id           String    @id @default(uuid())
  title        String
  artistId     String
  coverUrl     String?
  releaseYear  Int?
  releaseDate  DateTime?
  genre        String?
  deezerId     String?
  copyright    String?
  createdAt    DateTime  @default(now())

  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks   Track[]
}

model Track {
  id                String    @id @default(uuid())
  title             String
  artistId          String
  albumId           String?
  duration          Int
  trackNumber       Int?
  genre             String?
  audioUrl          String
  coverUrl          String?
  sourceHash        String?   @unique
  source            String    @default("telegram")
  telegramFileId    String?   @unique
  telegramMessageId String?
  deezerId          String?
  isrc              String?
  previewUrl        String?
  createdAt         DateTime  @default(now())

  artist           Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album            Album?             @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackArtists     TrackArtist[]
  playlistTracks   PlaylistTrack[]
  favorites        Favorite[]
  listeningHistory ListeningHistory[]
  credits          TrackCredit[]
  samples          SampledTrack[]     @relation("TrackSamples")
  sampledBy        SampledTrack[]     @relation("TrackSampled")
  snoozedBy        SnoozedTrack[]

  @@index([artistId])
  @@index([albumId])
  @@index([deezerId])
  @@index([telegramMessageId])
  @@index([title])
  @@index([createdAt])
}

model TrackArtist {
  trackId    String
  artistId   String
  role       String   @default("main")
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  coverUrl    String?
  folderId    String?
  createdAt   DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]
  folder PlaylistFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model PlaylistFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists Playlist[]
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([trackId])
}

model TrackCredit {
  id        String   @id @default(uuid())
  trackId   String
  name      String
  role      String   // "producer", "songwriter", "engineer", "mixer", "mastering"
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

model SampledTrack {
  id              String   @id @default(uuid())
  trackId         String   // the track that contains the sample
  sampledTrackId  String   // the track being sampled
  sampleType      String   // "samples", "covered", "remixed", "interpolated"
  createdAt       DateTime @default(now())

  track        Track @relation("TrackSamples", fields: [trackId], references: [id], onDelete: Cascade)
  sampledTrack Track @relation("TrackSampled", fields: [sampledTrackId], references: [id], onDelete: Cascade)

  @@unique([trackId, sampledTrackId, sampleType])
  @@index([trackId])
  @@index([sampledTrackId])
}

model Favorite {
  userId  String
  trackId String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model SnoozedTrack {
  userId    String
  trackId   String
  snoozedAt DateTime @default(now())
  expiresAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
  @@index([expiresAt])
}

model ListeningHistory {
  id       String   @id @default(uuid())
  userId   String
  trackId  String
  playedAt DateTime @default(now())
  skipped  Boolean  @default(false)

  // ── Signal columns ────────────────────────────────────────────────────────
  // A bare "this track was played" row can't distinguish a song someone loved
  // from one they killed after two seconds. These make every play a graded
  // signal the taste engine can weight.
  msPlayed   Int      @default(0)  // actual audible playback time, not wall clock
  completed  Boolean  @default(false)
  skipAtMs   Int?                  // where in the track the skip happened
  context    String?               // "mix" | "radio" | "playlist" | "album" | "artist" | "search" | "liked" | "library" | "chart" | "direct"
  contextId  String?               // id of the mix/playlist/album that sourced it
  autoplay   Boolean  @default(false) // true when radio queued it, not the person
  hourOfDay  Int?                  // 0-23, local to the listener — powers time-of-day mixes
  dayOfWeek  Int?                  // 0-6

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@index([playedAt])
  @@index([userId, playedAt])
  @@index([userId, trackId])
}

// ── Taste system ────────────────────────────────────────────────────────────
// Three layers:
//   1. TasteProfile   — the cached, denormalised summary (fast to read on every
//                       home render / radio call).
//   2. ArtistAffinity — per-artist running score, the strongest single signal.
//   3. GenreAffinity  — per-genre running score, what generalises to new music.
// Affinities are recomputed from ListeningHistory + Favorite + explicit
// feedback rather than incremented blindly, so a rebuild is always idempotent.

model TasteProfile {
  userId          String   @id
  onboarded       Boolean  @default(false)
  seedArtistIds   String[]                  // artists picked during onboarding
  seedGenres      String[]                  // genres picked during onboarding
  seedArtistNames String[]                  // names kept for artists not yet in the catalogue
  topGenres       String[]                  // ordered, derived
  topArtistIds    String[]                  // ordered, derived
  // 0 = "only play me what I know", 1 = "surprise me". Seeded from onboarding,
  // then nudged by behaviour (how often unfamiliar tracks survive vs get skipped).
  discovery       Float    @default(0.35)
  // Rolling behavioural stats used for scoring + shown back to the user.
  eraCenter       Int?                      // mean release year the person leans toward
  eraSpread       Int?
  avgTrackMs      Int?
  skipRate        Float    @default(0)
  totalPlays      Int      @default(0)
  vector          Json?                     // { genres: {}, eras: {}, hours: {} } — full weights
  computedAt      DateTime @default(now())
  version         Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArtistAffinity {
  userId      String
  artistId    String
  score       Float    @default(0)   // decayed, signed. negative = actively disliked
  plays       Int      @default(0)
  completions Int      @default(0)
  skips       Int      @default(0)
  likes       Int      @default(0)
  lastPlayedAt DateTime?
  updatedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId, score])
  @@index([artistId])
}

model GenreAffinity {
  userId    String
  genre     String
  score     Float    @default(0)
  plays     Int      @default(0)
  skips     Int      @default(0)
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, genre])
  @@index([userId, score])
}

// Explicit, deliberate feedback — worth far more than an implicit play signal.
// kind: "love" | "ban" | "more" | "less"
// target: "track" | "artist" | "genre"
model TasteFeedback {
  id        String   @id @default(uuid())
  userId    String
  target    String
  targetId  String              // trackId / artistId / genre string
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, target, targetId])
  @@index([userId])
}

// ── User Mixes ("Made for you" / Discover Weekly etc.) ──────────────────────
// Populated server-side from listening history + favourites.
// Re-generated on demand (or via a cron). Each mix holds an ordered list of
// track IDs stored as a simple array; no join table needed at this scale.
model UserMix {
  id          String   @id @default(uuid())
  userId      String
  kind        String   @default("generic") // "daily" | "discover" | "repeat" | "timeofday" | "deepcuts" | "throwback" | "artist" | "genre"
  slot        Int      @default(0)         // stable ordering within a kind (Daily Mix 1/2/3)
  label       String                // e.g. "Discover Weekly", "Daily Mix 1"
  subtitle    String?               // "Burna Boy, Wizkid, Asake and more"
  description String?
  coverUrl    String?
  coverUrls   String[]              // up to 4 covers for a mosaic tile
  tint        String   @default("a") // "a" | "b" — gradient variant
  seedGenres  String[]
  trackIds    String[]               // ordered list of track IDs
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, kind, slot])
}

// ── System Playlists (Top 50 Global, Nigeria, Africa, etc.) ──────────────────
// Populated from third-party APIs (Last.fm, RapidAPI, Deezer).
// Updated daily via the first API request of the day.
model SystemPlaylist {
  id          String   @id @default(uuid())
  systemId    String   @unique // e.g., "top-50-global", "top-50-nigeria", "top-50-africa"
  name        String
  description String?
  coverUrl    String?
  trackIds    String[] // ordered list of track IDs
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([systemId])
}
