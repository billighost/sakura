# Telegram API credentials — https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated by `npm run login`. Put it HERE and NOWHERE ELSE.
# A second copy of this string (Vercel, another machine, another worker) is what
# revokes it.
TELEGRAM_SESSION_STRING=

# The bot the session talks to.
TELEGRAM_BOT_USERNAME=musicshuntersbot

# Shared secret between this worker and the Next.js app. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=

# Where the post-DC-migration session is cached. Local default keeps it out of
# the repo; the Docker image sets /data/session.json.
SESSION_FILE=./data/session.json

PORT=8080
