# Sakura — app environment
#
# Copy to `.env` and fill in. This file is for the **Next.js app**; the Telegram
# worker has its own, separate environment (see worker/.env.example).
#
# The split is not cosmetic. Read the Telegram section before setting anything
# with TELEGRAM in the name.

# ─── Data stores ──────────────────────────────────────────────────────────────

DATABASE_URL="postgres://user:pass@host/dbname"

# Upstash is metered in *commands*, not bytes. One database is shared by
# production, previews and every developer's laptop, so all cache keys carry a
# `prod:` / `preview:` / `dev:` prefix (lib/deployEnv.ts). Nothing here needs
# separate instances per environment; the prefix is what keeps them apart.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Also the key that encrypts stored Spotify refresh tokens (lib/spotifyAuth.ts).
# Changing it logs everyone out *and* drops every Spotify connection — users can
# reconnect in one click, but it is not a free rotation.
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Media storage ────────────────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Telegram ─────────────────────────────────────────────────────────────────
#
# There is no TELEGRAM_SESSION_STRING here, and adding one is a mistake.
#
# Telegram permanently revokes an auth key the moment it sees that key on two
# live connections from different IPs. Vercel runs many instances, each on its
# own IP, and preview deployments inherit production's env vars — so any session
# string reachable from this app is a session string about to be revoked. A lock
# does not help: it serialises the handshake, but the socket outlives the lock.
#
# MTProto therefore lives in exactly one long-running process (`worker/`), which
# holds one connection for its lifetime. This app talks to it over HTTP. There is
# no in-process fallback, deliberately — a fallback capable of opening an MTProto
# connection from here would recreate the whole problem, and would fire on the
# day nobody expected it (a forgotten .env, a rollback, a preview build).
#
# If you have a TELEGRAM_SESSION_STRING in a Vercel environment from before the
# worker existed, remove it. The app logs an error about it on boot.
#
#   vercel env rm TELEGRAM_SESSION_STRING production
#   vercel env rm TELEGRAM_SESSION_STRING preview
#   vercel env rm TELEGRAM_SESSION_STRING development

# Base URL of the worker, no trailing slash. Without this (and WORKER_SECRET)
# every Telegram-backed feature fails with a message telling you to set them.
TELEGRAM_WORKER_URL="https://sakura-tg-worker.fly.dev"

# Shared bearer secret. Must match the worker's WORKER_SECRET exactly — the
# worker is a public HTTP endpoint that can download from a real Telegram
# account, and this is the only thing standing in front of it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=""

# Set to "1" to have the worker stream audio bytes back through this app instead
# of the app fetching them itself. Off by default: it doubles the bandwidth for
# every byte of every download, and Fly's free allowance is the tighter budget.
TELEGRAM_WORKER_DIRECT_AUDIO=""

# Which bot to search. Set in *both* places — the app uses it to build the
# fallback chain, the worker uses it to send messages.
TELEGRAM_BOT_USERNAME="musicshuntersbot"
# Comma-separated bots to try when the primary returns nothing.
TELEGRAM_FALLBACK_BOTS=""

# ─── Spotify import ───────────────────────────────────────────────────────────
#
# Authorization Code + PKCE, so there is no client secret in this app. Add
# `<origin>/api/auth/spotify/callback` to the app's redirect URIs in the Spotify
# dashboard — for every origin you use, including localhost and preview domains.
#
# SPOTIFY_CLIENT_SECRET is only needed for the keyless client-credentials
# helpers (lib/spotify.ts getSpotifyToken); user-connected imports don't use it.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ─── Metadata providers ───────────────────────────────────────────────────────

# MusicBrainz requires a User-Agent that identifies the app and gives them a way
# to reach whoever runs it. They block by UA string, and the block outlives the
# deploy that earned it. An email address or a real project URL.
#
# Unset falls back to NEXTAUTH_URL with a warning. The previous hard-coded value
# pointed at a repository that does not exist, which passes the format check and
# defeats the point.
MUSICBRAINZ_CONTACT=""
