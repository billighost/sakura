generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  username         String             @unique
  email            String             @unique
  passwordHash     String
  avatarUrl        String?
  bio              String?
  createdAt        DateTime           @default(now())
  
  settings         UserSettings?
  playlists        Playlist[]
  playlistFolders  PlaylistFolder[]
  favorites        Favorite[]
  snoozedTracks    SnoozedTrack[]
  listeningHistory ListeningHistory[]
  mixes            UserMix[]
  tasteProfile     TasteProfile?
  artistAffinities ArtistAffinity[]
  genreAffinities  GenreAffinity[]
  tasteFeedback    TasteFeedback[]
  playbackState    PlaybackState?
  shares           Share[]
  playAggregates   PlayAggregate[]
  spotify          SpotifyConnection?
}

/// A connected Spotify account. At most one per user, so `userId` is the key.
///
/// `refreshToken` is the durable half and the reason this table exists — the
/// OAuth callback used to discard it and keep only a one-hour access-token
/// cookie, so the app forgot every connection hourly. `accessToken`/`expiresAt`
/// are a cache: safe to drop, re-minted from the refresh token on next use.
///
/// Both token columns hold AES-256-GCM ciphertext, not the tokens themselves.
/// See lib/spotifyAuth.ts.
model SpotifyConnection {
  userId       String   @id @db.Uuid
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique @db.Uuid
  // "system" | "light" | "dark". Defaults to "system" — *not* "dark", because a
  // row created as a side effect of saving some unrelated setting must not look
  // like the user chose a palette. It used to default to "dark", which made
  // opening the settings page repaint the whole app dark for anyone who had
  // never picked a theme. See lib/theme.ts's getStoredTheme().
  theme                String   @default("system")
  audioQuality         String   @default("high")
  downloadQuality      String   @default("high")
  crossfadeSeconds     Int      @default(0)
  autoDownloadLiked    Boolean  @default(false)
  gaplessPlayback      Boolean  @default(true)
  normalizeVolume      Boolean  @default(true)
  explicitContent      Boolean  @default(true)
  privateSession       Boolean  @default(false)
  pushNotifications    Boolean  @default(true)
  newReleaseAlerts     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Artist {
  id         String   @id @default(uuid())
  name       String   @unique
  imageUrl   String?
  bio        String?
  deezerId   String?
  genres     String[]
  createdAt  DateTime @default(now())

  albums        Album[]
  tracks        Track[]
  trackArtists  TrackArtist[]
  affinities    ArtistAffinity[]
}

model Album {
  id           String    @id @default(uuid())
  title        String
  artistId     String
  coverUrl     String?
  releaseYear  Int?
  releaseDate  DateTime?
  genre        String?
  deezerId     String?
  copyright    String?
  createdAt    DateTime  @default(now())

  artist   Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks   Track[]
}

model Track {
  id                String    @id @default(uuid())
  title             String
  artistId          String
  albumId           String?
  duration          Int
  trackNumber       Int?
  genre             String?
  audioUrl          String
  coverUrl          String?
  sourceHash        String?   @unique
  source            String    @default("telegram")
  telegramFileId    String?   @unique
  telegramMessageId String?
  deezerId          String?
  isrc              String?
  previewUrl        String?
  createdAt         DateTime  @default(now())

  artist           Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album            Album?             @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackArtists     TrackArtist[]
  playlistTracks   PlaylistTrack[]
  favorites        Favorite[]
  listeningHistory ListeningHistory[]
  credits          TrackCredit[]
  samples          SampledTrack[]     @relation("TrackSamples")
  sampledBy        SampledTrack[]     @relation("TrackSampled")
  snoozedBy        SnoozedTrack[]

  @@index([artistId])
  @@index([albumId])
  @@index([deezerId])
  @@index([telegramMessageId])
  @@index([title])
  @@index([createdAt])
  playAggregates PlayAggregate[]
}

model TrackArtist {
  trackId    String
  artistId   String
  role       String   @default("main")
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
}

model Playlist {
  id          String   @id @default(uuid())
  userId      String @db.Uuid
  name        String
  description String?
  coverUrl    String?
  folderId    String?
  // Opt-in discovery. Private by default: a playlist only becomes findable in
  // search when its owner explicitly publishes it from the profile page.
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]
  folder PlaylistFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
}

model PlaylistFolder {
  id        String   @id @default(uuid())
  userId    String @db.Uuid
  name      String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists Playlist[]
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([trackId])
}

model TrackCredit {
  id        String   @id @default(uuid())
  trackId   String
  name      String
  role      String   // "producer", "songwriter", "engineer", "mixer", "mastering"
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

model SampledTrack {
  id              String   @id @default(uuid())
  trackId         String   // the track that contains the sample
  sampledTrackId  String   // the track being sampled
  sampleType      String   // "samples", "covered", "remixed", "interpolated"
  createdAt       DateTime @default(now())

  track        Track @relation("TrackSamples", fields: [trackId], references: [id], onDelete: Cascade)
  sampledTrack Track @relation("TrackSampled", fields: [sampledTrackId], references: [id], onDelete: Cascade)

  @@unique([trackId, sampledTrackId, sampleType])
  @@index([trackId])
  @@index([sampledTrackId])
}

model Favorite {
  userId  String @db.Uuid
  trackId String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model SnoozedTrack {
  userId    String @db.Uuid
  trackId   String
  snoozedAt DateTime @default(now())
  expiresAt DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
  @@index([expiresAt])
}

model ListeningHistory {
  id       BigInt   @id @default(autoincrement())
  userId   String @db.Uuid
  trackId  String
  playedAt DateTime @default(now())
  skipped  Boolean  @default(false)

  // ── Signal columns ────────────────────────────────────────────────────────
  // A bare "this track was played" row can't distinguish a song someone loved
  // from one they killed after two seconds. These make every play a graded
  // signal the taste engine can weight.
  msPlayed   Int      @default(0)  // actual audible playback time, not wall clock
  completed  Boolean  @default(false)
  skipAtMs   Int?                  // where in the track the skip happened
  context    String?               // "mix" | "radio" | "playlist" | "album" | "artist" | "search" | "liked" | "library" | "chart" | "direct"
  contextId  String?               // id of the mix/playlist/album that sourced it
  autoplay   Boolean  @default(false) // true when radio queued it, not the person
  hourOfDay  Int?                  // 0-23, local to the listener — powers time-of-day mixes
  dayOfWeek  Int?                  // 0-6

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@index([playedAt])
  @@index([userId, playedAt])
  @@index([userId, trackId])
}

// ── Taste system ────────────────────────────────────────────────────────────
// Three layers:
//   1. TasteProfile   — the cached, denormalised summary (fast to read on every
//                       home render / radio call).
//   2. ArtistAffinity — per-artist running score, the strongest single signal.
//   3. GenreAffinity  — per-genre running score, what generalises to new music.
// Affinities are recomputed from ListeningHistory + Favorite + explicit
// feedback rather than incremented blindly, so a rebuild is always idempotent.

model TasteProfile {
  userId          String   @id @db.Uuid
  onboarded       Boolean  @default(false)
  seedArtistIds   String[]                  // artists picked during onboarding
  seedGenres      String[]                  // genres picked during onboarding
  seedArtistNames String[]                  // names kept for artists not yet in the catalogue
  topGenres       String[]                  // ordered, derived
  topArtistIds    String[]                  // ordered, derived
  // 0 = "only play me what I know", 1 = "surprise me". Seeded from onboarding,
  // then nudged by behaviour (how often unfamiliar tracks survive vs get skipped).
  discovery       Float    @default(0.35)
  // Rolling behavioural stats used for scoring + shown back to the user.
  eraCenter       Int?                      // mean release year the person leans toward
  eraSpread       Int?
  avgTrackMs      Int?
  skipRate        Float    @default(0)
  totalPlays      Int      @default(0)
  vector          Json?                     // { genres: {}, eras: {}, hours: {} } — full weights
  computedAt      DateTime @default(now())
  version         Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArtistAffinity {
  userId      String @db.Uuid
  artistId    String
  score       Float    @default(0)   // decayed, signed. negative = actively disliked
  plays       Int      @default(0)
  completions Int      @default(0)
  skips       Int      @default(0)
  likes       Int      @default(0)
  lastPlayedAt DateTime?
  updatedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId, score])
  @@index([artistId])
}

model GenreAffinity {
  userId    String @db.Uuid
  genre     String
  score     Float    @default(0)
  plays     Int      @default(0)
  skips     Int      @default(0)
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, genre])
  @@index([userId, score])
}

// Explicit, deliberate feedback — worth far more than an implicit play signal.
// kind: "love" | "ban" | "more" | "less"
// target: "track" | "artist" | "genre"
model TasteFeedback {
  id        String   @id @default(uuid())
  userId    String @db.Uuid
  target    String
  targetId  String              // trackId / artistId / genre string
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, target, targetId])
  @@index([userId])
}

// ── User Mixes ("Made for you" / Discover Weekly etc.) ──────────────────────
// Populated server-side from listening history + favourites.
// Re-generated on demand (or via a cron). Each mix holds an ordered list of
// track IDs stored as a simple array; no join table needed at this scale.
model UserMix {
  id          String   @id @default(uuid())
  userId      String @db.Uuid
  kind        String   @default("generic") // "daily" | "discover" | "repeat" | "timeofday" | "deepcuts" | "throwback" | "artist" | "genre"
  slot        Int      @default(0)         // stable ordering within a kind (Daily Mix 1/2/3)
  label       String                // e.g. "Discover Weekly", "Daily Mix 1"
  subtitle    String?               // "Burna Boy, Wizkid, Asake and more"
  description String?
  coverUrl    String?
  coverUrls   String[]              // up to 4 covers for a mosaic tile
  tint        String   @default("a") // "a" | "b" — gradient variant
  seedGenres  String[]
  trackIds    String[]               // ordered list of track IDs
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, kind, slot])
}

// ── System Playlists (Top 50 Global, Nigeria, Africa, etc.) ──────────────────
// Populated from third-party APIs (Last.fm, RapidAPI, Deezer).
// Updated daily via the first API request of the day.
model SystemPlaylist {
  id          String   @id @default(uuid())
  systemId    String   @unique // e.g., "top-50-global", "top-50-nigeria", "top-50-africa"
  name        String
  description String?
  coverUrl    String?
  trackIds    String[] // ordered list of track IDs
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([systemId])
}

// ── Cross-device continuity ─────────────────────────────────────────────────
// Playback state lived only in localStorage, so a queue built on the phone was
// invisible on the laptop and "resume where I left off" reset on every device
// change. One row per user, last-writer-wins on `updatedAt`.
//
// The queue is stored denormalised (title/artist/cover inline, not just track
// ids) on purpose: the receiving device must be able to render the queue before
// it has resolved any of those ids against its own cache, and a track that has
// since been removed from the catalogue should still display rather than
// vanish.
model PlaybackState {
  userId      String   @id @db.Uuid
  trackId     String?
  positionMs  Int      @default(0)
  durationMs  Int      @default(0)
  isPlaying   Boolean  @default(false)

  queue       Json?    // Track[] — denormalised, see above
  upNext      Json?    // Track[]
  queueIndex  Int      @default(0)

  shuffle     Boolean  @default(false)
  repeat      String   @default("off") // "off" | "one" | "all"

  context     String?  // "playlist" | "album" | "mix" | "radio" | ...
  contextId   String?

  // Which device wrote this. Lets a device ignore the echo of its own write
  // instead of clobbering a newer local position with its own stale one.
  deviceId    String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Sharing ─────────────────────────────────────────────────────────────────
// A share is a durable, addressable object rather than a one-off image blob, so
// a link keeps working after the image is out of the recipient's cache, and so
// open-graph previews can be rendered server-side.
model Share {
  id        String   @id @default(uuid())
  slug      String   @unique          // short, URL-safe public identifier
  userId    String @db.Uuid
  kind      String                    // "lyric" | "track" | "playlist" | "album" | "artist" | "mix"

  targetId  String?                   // track/playlist/album id this points at
  // Lyric shares: the selected lines plus their timing, so the card can be
  // re-rendered at any size and the recipient can jump to that moment.
  payload   Json

  theme     String   @default("auto") // card variant chosen by the sharer
  views     Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([kind])
  @@index([createdAt])
}

/// Rolled-up listening history. One row per (user, track) replaces every
/// individual play older than HISTORY_RAW_DAYS, which is what keeps
/// ListeningHistory — the only table that grows with time rather than with
/// catalogue or userbase — bounded on a 500MB tier.
///
/// signalSum is the exact sum of signalWeight() over the folded rows, computed
/// while they still existed. It is stored rather than re-derived because
/// signalWeight is continuous in the played/duration ratio: reconstructing it
/// from counts and averages measured 90% high and reordered users' top artists.
model PlayAggregate {
  userId        String   @db.Uuid
  trackId       String
  plays         Int      @default(0)
  completions   Int      @default(0)
  skips         Int      @default(0)
  totalMsPlayed BigInt   @default(0)
  signalSum     Float    @default(0)
  firstPlayedAt DateTime
  lastPlayedAt  DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
}
