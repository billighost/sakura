{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sakura-audio",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "TELEGRAM_OWNER", "class_name": "TelegramOwner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TelegramOwner"] }],
  "vars": { "TELEGRAM_ENABLED": "false", "TELEGRAM_BOT_USERNAME": "musicshuntersbot" }
}
