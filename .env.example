# Sakura Ink app configuration. Copy to .env and provide your own values.
# All values remain server only. The Telegram session belongs to worker/.env.

DATABASE_URL="postgres://user:password@host/database"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public Deezer metadata and LRCLib lyrics require no API key.
# Optional Spotify metadata fallback; no Spotify user connection or audio subscription.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Existing single-owner Telegram audio worker.
TELEGRAM_WORKER_URL=""
WORKER_SECRET=""
TELEGRAM_BOT_USERNAME="musicshuntersbot"
# Fallback chats need the scoped v2 worker; v1 compatibility uses only the primary.
TELEGRAM_FALLBACK_BOTS=""

# Optional verified full-audio CDN preparation on the existing account.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SAKURA_REBUILD_AUDIO_ORIGINS="https://res.cloudinary.com"

# Optional public YouTube playlist metadata import.
YOUTUBE_API_KEY=""
